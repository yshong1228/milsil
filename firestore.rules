rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /quests/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /records/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /members/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /config/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}